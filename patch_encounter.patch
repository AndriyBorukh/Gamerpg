+    const handleCompanionAbility = (companion: HiredCompanion) => {
+        if (companion.currentAbilityCharges <= 0) return;
+        const cClass = COMPANION_CLASSES[companion.companionClassId];
+        if (!cClass) return;
+        
+        const updatedProgress = { ...progress };
+        const companions = [...(updatedProgress.hiredNpcs || [])];
+        const cIdx = companions.findIndex(c => c.id === companion.id);
+        if (cIdx >= 0) {
+            companions[cIdx] = { ...companions[cIdx], currentAbilityCharges: companions[cIdx].currentAbilityCharges - 1 };
+        }
+        updatedProgress.hiredNpcs = companions;
+
+        let newSquad = { ...squad };
+        let logMsg = `${companion.name} використовує здібність "${cClass.abilityName}"! `;
+
+        if (cClass.abilityType === 'damage_single') {
+            // Auto target leader if alive, else first alive ally
+            if (!newSquad.leader.isDefeated) {
+                newSquad.leader.hp -= cClass.abilityPower;
+                if (newSquad.leader.hp <= 0) newSquad.leader.isDefeated = true;
+                logMsg += `Завдано ${cClass.abilityPower} шкоди вожаку!`;
+            } else {
+                const aliveAllyIdx = newSquad.allies.findIndex(a => !a.isDefeated);
+                if (aliveAllyIdx >= 0) {
+                    newSquad.allies[aliveAllyIdx].hp -= cClass.abilityPower;
+                    if (newSquad.allies[aliveAllyIdx].hp <= 0) newSquad.allies[aliveAllyIdx].isDefeated = true;
+                    logMsg += `Завдано ${cClass.abilityPower} шкоди союзнику!`;
+                }
+            }
+        } else if (cClass.abilityType === 'damage_aoe') {
+            if (!newSquad.leader.isDefeated) {
+                newSquad.leader.hp -= cClass.abilityPower;
+                if (newSquad.leader.hp <= 0) newSquad.leader.isDefeated = true;
+            }
+            newSquad.allies.forEach(a => {
+                if (!a.isDefeated) {
+                    a.hp -= cClass.abilityPower;
+                    if (a.hp <= 0) a.isDefeated = true;
+                }
+            });
+            logMsg += `Завдано ${cClass.abilityPower} шкоди всім ворогам!`;
+        } else if (cClass.abilityType === 'buff_player') {
+            setPreemptiveDamage(prev => prev + cClass.abilityPower);
+            logMsg += `Отримано посилення перед боєм!`;
+        } else if (cClass.abilityType === 'summon' && cClass.summonTemplate) {
+            const summon: HiredCompanion = {
+                id: `summon_${Date.now()}`,
+                name: cClass.summonTemplate.name || 'Призов',
+                title: cClass.summonTemplate.title || 'Істота',
+                avatar: cClass.summonTemplate.avatar || '👻',
+                hp: cClass.summonTemplate.baseHp || 50,
+                baseHp: cClass.summonTemplate.baseHp || 50,
+                strength: cClass.summonTemplate.strength || 5,
+                agility: cClass.summonTemplate.agility || 5,
+                armor: cClass.summonTemplate.armor || 0,
+                difficulty: 'Легко',
+                companionClassId: 'summon',
+                level: 0,
+                xp: 0,
+                xpToNextLevel: 100,
+                maxAbilityCharges: 0,
+                currentAbilityCharges: 0,
+                survivalProbability: 100,
+                isDead: false,
+                isSummon: true
+            };
+            updatedProgress.hiredNpcs.push(summon);
+            logMsg += `Призвано істоту ${summon.name}!`;
+        } else if (cClass.abilityType === 'raise_undead' && cClass.summonTemplate) {
+            const deadIdx = updatedProgress.hiredNpcs.findIndex(c => c.isDead);
+            if (deadIdx >= 0) {
+                const deadCompanion = updatedProgress.hiredNpcs[deadIdx];
+                updatedProgress.hiredNpcs.splice(deadIdx, 1);
+                const undead: HiredCompanion = {
+                    ...deadCompanion,
+                    name: cClass.summonTemplate.name || 'Нежить',
+                    title: cClass.summonTemplate.title || 'Мрець',
+                    avatar: cClass.summonTemplate.avatar || '💀',
+                    hp: cClass.summonTemplate.baseHp || 50,
+                    baseHp: cClass.summonTemplate.baseHp || 50,
+                    isDead: false,
+                    isSummon: true,
+                    companionClassId: 'undead'
+                };
+                updatedProgress.hiredNpcs.push(undead);
+                logMsg += `Мертве тіло перетворено на нежить!`;
+            } else {
+                logMsg += `Немає мертвих союзників для підняття!`;
+                // Revert charge
+                companions[cIdx].currentAbilityCharges += 1;
+            }
+        }
+
+        setCombatLog(prev => [logMsg, ...prev].slice(0, 5));
+        onUpdateProgress(updatedProgress);
+        onSquadUpdate(newSquad);
+    };
+
+    const handleCompanionAutoCombat = (companion: HiredCompanion, targetType: 'leader'|'ally', allyIndex?: number) => {
+        const updatedProgress = { ...progress };
+        const companions = [...(updatedProgress.hiredNpcs || [])];
+        const cIdx = companions.findIndex(c => c.id === companion.id);
+        if (cIdx < 0) return;
+
+        let target = targetType === 'leader' ? squad.leader : squad.allies[allyIndex!];
+        let newSquad = { ...squad };
+
+        const compPower = (companion.strength || 1) + (companion.agility || 1);
+        const targetPower = (target.strength || 1) + (target.agility || 1);
+        
+        let logMsg = '';
+        const winChance = Math.min(90, Math.max(10, (compPower / (compPower + targetPower)) * 100));
+        const roll = Math.random() * 100;
+
+        if (roll <= winChance) {
+            // Companion wins
+            logMsg = `⚔️ ${companion.name} перемагає ${target.name}!`;
+            if (targetType === 'leader') newSquad.leader.isDefeated = true;
+            else newSquad.allies[allyIndex!].isDefeated = true;
+
+            // XP and Level up
+            if (!companion.isSummon) {
+                const xpGain = 50 + (target.strength || 0) * 10;
+                companions[cIdx].xp += xpGain;
+                logMsg += ` Отримано ${xpGain} XP.`;
+                if (companions[cIdx].xp >= companions[cIdx].xpToNextLevel) {
+                    companions[cIdx].level += 1;
+                    companions[cIdx].xp -= companions[cIdx].xpToNextLevel;
+                    companions[cIdx].xpToNextLevel = Math.floor(companions[cIdx].xpToNextLevel * 1.5);
+                    companions[cIdx].maxAbilityCharges = companions[cIdx].level + 1;
+                    companions[cIdx].currentAbilityCharges = companions[cIdx].maxAbilityCharges;
+                    companions[cIdx].strength = (companions[cIdx].strength || 1) + 1;
+                    companions[cIdx].agility = (companions[cIdx].agility || 1) + 1;
+                    companions[cIdx].baseHp = (companions[cIdx].baseHp || 10) + 10;
+                    logMsg += ` 🌟 Рівень підвищено! Здібності відновлено.`;
+                }
+            }
+        } else {
+            // Companion loses
+            logMsg = `❌ ${companion.name} зазнає поразки від ${target.name}.`;
+            if (!companion.isSummon) {
+                const survivalRoll = Math.random() * 100;
+                if (survivalRoll <= companion.survivalProbability) {
+                    companions[cIdx].survivalProbability = Math.max(0, companions[cIdx].survivalProbability - 10);
+                    logMsg += ` Дивом виживає (шанс виживання впав до ${companions[cIdx].survivalProbability}%).`;
+                } else {
+                    companions[cIdx].isDead = true;
+                    logMsg += ` ☠️ Гине в бою...`;
+                }
+            } else {
+                companions[cIdx].isDead = true;
+                logMsg += ` Призвана істота знищена.`;
+            }
+        }
+
+        setActiveCompanionAction(null);
+        setCombatLog(prev => [logMsg, ...prev].slice(0, 5));
+        updatedProgress.hiredNpcs = companions;
+        onUpdateProgress(updatedProgress);
+        onSquadUpdate(newSquad);
+    };
+
